rules_version = '2';

// Règles de sécurité CalenTour v2.
// - Les comptes sont créés par un administrateur (un par binôme).
// - Un binôme lit sa tournée et enregistre ses passages ; il ne voit les autres
//   tournées que si le classement lui est ouvert.
// - Les administrateurs gèrent tout.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function isAdmin() { return isMember() && me().role == 'admin'; }
    function settings() { return get(/databases/$(database)/documents/settings/app).data; }
    function myTour(tourId) { return isMember() && me().tourId == tourId; }
    function canSeeAll() { return isAdmin() || (isMember() && settings().rankingForMembers == true); }
    function settingsExist() { return exists(/databases/$(database)/documents/settings/app); }

    // Nom de l'amicale lisible avant connexion (écran de connexion).
    match /settings/app {
      allow read: if true;
      // Premier lancement : création par le futur premier administrateur.
      allow create: if signedIn() && !settingsExist()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && !settingsExist()
            && request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/settings/app).data.year is int);
      allow update, delete: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if myTour(tourId) || canSeeAll();
      allow write: if isAdmin();
      // Un binôme peut ajouter une maison oubliée à sa tournée (liste des maisons seulement).
      allow update: if myTour(tourId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['houses', 'updatedAt']);
    }

    match /campaigns/{year}/state/{tourId} {
      allow read: if myTour(tourId) || canSeeAll();
      // Un binôme écrit uniquement l'état de sa tournée, pour la campagne en cours.
      allow create, update: if isAdmin()
        || (myTour(tourId) && int(year) == settings().year
            && request.resource.data.keys().hasOnly(['h']));
      allow delete: if isAdmin();
    }

    match /campaigns/{year}/passages/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (myTour(request.resource.data.tourId) && int(year) == settings().year
            && request.resource.data.by == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}

rules_version = '2';

// Règles de sécurité CalenTour.
// - Seules les personnes invitées par un administrateur peuvent créer leur compte.
// - Les membres lisent tout et enregistrent les passages de la campagne active.
// - Les administrateurs gèrent membres, communes, secteurs, adresses et campagnes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }
    function isAdmin() {
      return isMember() && profile().role == 'admin';
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function invitation() {
      return get(/databases/$(database)/documents/invitations/$(myEmail())).data;
    }

    match /users/{uid} {
      allow read: if isMember();
      // Création de son propre profil, uniquement avec le rôle prévu par l'invitation.
      allow create: if signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invitations/$(myEmail()))
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'active', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.role == invitation().role
        && request.resource.data.active == true;
      // Un membre peut changer son nom, rien d'autre.
      allow update: if isAdmin()
        || (isMember() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    match /invitations/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'member'];
      allow delete: if isAdmin() || (signedIn() && myEmail() == email);
    }

    match /communes/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /sectors/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /sectorAddresses/{sectorId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /campaigns/{year} {
      allow read: if isMember();
      allow write: if isAdmin();

      match /sectorVisits/{sectorId} {
        allow read: if isMember();
        // Les membres saisissent les passages de la campagne active uniquement.
        allow create, update: if isAdmin()
          || (isMember()
              && get(/databases/$(database)/documents/campaigns/$(year)).data.active == true
              && request.resource.data.keys().hasOnly(['visits', 'updatedAt']));
        allow delete: if isAdmin();
      }
    }
  }
}

# Copier ce fichier en .env.local et remplir avec la config Web de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Application Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optionnel : centre de la carte au premier lancement (longitude, latitude, zoom)
VITE_MAP_CENTER_LNG=2.35
VITE_MAP_CENTER_LAT=48.85
VITE_MAP_ZOOM=13
